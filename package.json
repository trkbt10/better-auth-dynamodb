{
  "name": "@trkbt10/better-auth-dynamodb",
  "version": "0.3.0",
  "license": "Unlicense",
  "description": "A Better Auth adapter for DynamoDB with schema generation, indexed queries, and atomic writes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trkbt10/better-auth-dynamodb.git"
  },
  "homepage": "https://github.com/trkbt10/better-auth-dynamodb#readme",
  "bugs": {
    "url": "https://github.com/trkbt10/better-auth-dynamodb/issues"
  },
  "keywords": ["better-auth", "dynamodb", "authentication", "adapter", "aws"],
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "bun@1.3.9",
  "sideEffects": false,
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/index.d.cts",
    "README.md",
    "UNLICENSE"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json && rollup -c rollup.types.config.js",
    "clean": "rimraf dist",
    "lint": "eslint . --max-warnings 0",
    "lint:package": "publint --strict",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:cov": "vitest run --coverage",
    "test": "vitest --run",
    "test:package": "bun run tools/check-package.ts",
    "test:chaos": "vitest run spec/chaos",
    "test:chaos:stress": "CHAOS_RUNS=1000 CHAOS_FLOW_RUNS=60 vitest run spec/chaos --testTimeout=600000",
    "pack": "bun pm pack --filename artifacts/package.tgz",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@better-auth/core": "^1.7.6",
    "better-auth": "^1.7.6"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1142.0",
    "@aws-sdk/lib-dynamodb": "^3.1142.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@better-auth/api-key": "^1.7.6",
    "@better-auth/core": "^1.7.6",
    "@better-auth/mcp": "^1.7.6",
    "@better-auth/oauth-provider": "^1.7.6",
    "@better-auth/scim": "^1.7.6",
    "@better-auth/sso": "^1.7.6",
    "@better-auth/test-utils": "^1.7.6",
    "@types/node": "24.10.13",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^4.1.11",
    "better-auth": "^1.7.6",
    "bun-types": "1.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^56.1.2",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.5",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
